{
  "name": "g1wiggle",
  "version": "1.0.0",
  "author": {
    "name": "urstrulyg1",
    "email": "support@urstrulyg1.dev"
  },
  "description": "An elegant, modern cursor automation and workstation keep-alive platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/urstrulyg1/G1Wiggle.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:pipeline": "vitest run tests/pipeline.test.ts tests/build-matrix.test.ts tests/e2e-pipeline.test.ts",
    "test:all": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "electron:dev": "electron . --dev",
    "electron:build": "electron-builder",
    "electron:mac": "electron-builder --mac --x64 --arm64",
    "electron:mac:x64": "electron-builder --mac --x64",
    "electron:mac:arm64": "electron-builder --mac --arm64",
    "electron:mac:universal": "electron-builder --mac --universal",
    "electron:win": "electron-builder --win --x64 --ia32 --arm64",
    "electron:win:x64": "electron-builder --win --x64",
    "electron:win:ia32": "electron-builder --win --ia32",
    "electron:win:arm64": "electron-builder --win --arm64",
    "electron:linux": "electron-builder --linux --x64 --arm64 --armv7l",
    "electron:linux:x64": "electron-builder --linux --x64",
    "electron:linux:arm64": "electron-builder --linux --arm64",
    "electron:linux:armv7l": "electron-builder --linux --armv7l",
    "electron:all": "electron-builder --mac --win --linux --x64 --arm64 --ia32 --armv7l",
    "build:desktop": "./build.sh",
    "build:desktop:win": "build.bat",
    "build:all": "node scripts/build-all.mjs",
    "build:all:dry": "node scripts/build-all.mjs --dry-run",
    "build:all:parallel": "node scripts/build-all.mjs --parallel",
    "pipeline:validate": "node scripts/test-pipeline.mjs",
    "pipeline:validate:verbose": "node scripts/test-pipeline.mjs --verbose"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.7.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.8"
  }
}